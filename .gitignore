# =============================================================================
# Complete .gitignore: Python + uv + Git LFS + Data Engineering (Azure/AWS/Databricks)
# =============================================================================
# NOTE: Do NOT ignore uv.lock or .python-version. Commit both for reproducible builds.
# NOTE: Git LFS is configured in .gitattributes, not here. Do not ignore files you
#       track with LFS (e.g. *.parquet), or they will never be committed.

# === uv ===
.uv/
.uv-cache/
.uv_cache/

# === Virtual Environments ===
.venv/
venv/
env/
ENV/
.virtualenv/

# === Python Caches & Build Artifacts ===
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/
.cache/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
*.egg
.installed.cfg
MANIFEST
# *.spec   <- uncomment only if you use PyInstaller (it matches any *.spec file)

# === Testing & Coverage ===
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py,cover
junit.xml
reports/

